  "about": {
    "subtitle": "Erfahren Sie mehr über das 9. SAMI-Sommerkursprogramm, die Ziele und Teilnahmevoraussetzungen.",
    "panel1": {
      "title": "Über den SAMI Summer Course",
      "text1": "Der SAMI Summer Course ist ein internationales akademisches Programm, das seit 2017 vom Department of Management der IPB University durchgeführt wird. Ziele: Steigerung der Wettbewerbsfähigkeit, Ausbau globaler Netzwerke und interkulturelles Lernen.",
      "text2": "Die 9. Auflage findet hybrid vom <strong>27. Juli bis 15. August 2026</strong> statt, Hauptstandort ist der IPB Dramaga Campus in Bogor. <strong>14 Kurse</strong> zu nachhaltigem Agrar- und Lebensmittelmanagement.",
      "theme": "Thema: <strong>\"Building Climate Resilience and Sustainable Agrifood Management through ESG\"</strong>"
    },
    "panel2": {
      "title": "Programmziele",
      "items": [
        "Verbesserung der Kenntnisse und Fähigkeiten der Teilnehmer",
        "Interaktives Lernen mit kollaborativen Ansätzen",
        "Ausbau internationaler Netzwerke",
        "Kulturen vorstellen und Kulturdiplomatie stärken"
      ]
    },
    "panel3": {
      "title": "Wer Kann Teilnehmen?",
